generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EMySkillRelation {
  HAVE
  WANT_TO_LEARN
}

enum EKnowledgeStatus {
  HAS
  WANTS_TO_LEARN
}

model Skill {
  id         String            @id @default(uuid())
  name       String
  myRelation EMySkillRelation?

  userSkills        UserSkill[]
  skillNameVariants SkillNameVariant[]
}

model SkillNameVariant {
  id       String @id @default(uuid())
  spelling String @unique
  skillId  String

  skill Skill @relation(fields: [skillId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  name         String
  registeredOn DateTime @default(now())

  userSkills UserSkill[]
}

model UserSkill {
  id                   String            @id @default(uuid())
  userId               String
  skillId              String
  knowledgeStatus      EKnowledgeStatus?
  lookingForDevsWithIt Boolean           @default(false)

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}
